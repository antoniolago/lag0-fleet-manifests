{
  "uid": "lag0-traffic",
  "title": "Lag0 · Tráfego da Rede (IPFIX)",
  "description": "Quanto cada dispositivo baixa e envia, quais serviços e conversas dominam a janela. Fonte: IPFIX do MikroTik → nfcapd → exporter lag0-metrics.",
  "tags": [
    "lag0",
    "rede",
    "ipfix",
    "trafego"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
