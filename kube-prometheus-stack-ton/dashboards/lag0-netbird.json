{
  "uid": "lag0-netbird",
  "title": "NetBird · Peers & Túneis",
  "description": "Malha NetBird do lag0: quem está conectado, se o caminho é P2P ou relay, latência, handshakes e throughput por peer. Fonte: netbird status -j (casa-router) e wg show (wg-client).",
  "tags": [
    "lag0",
    "netbird",
    "vpn"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Malha",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
