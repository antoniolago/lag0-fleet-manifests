    {
      "id": 9,
      "type": "table",
      "title": "Estado dos peers",
      "description": "Quem está conectado, por qual caminho (P2P ou relay), latência e há quanto tempo houve handshake.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 11,
        "w": 15,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "lag0_netbird_peer_info",
          "legendFormat": "peer",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(lag0_netbird_peer_transfer_bytes{direction=\"rx\"}[5m]) * 8",
          "legendFormat": "rx",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "rate(lag0_netbird_peer_transfer_bytes{direction=\"tx\"}[5m]) * 8",
          "legendFormat": "tx",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "lag0_netbird_peer_latency_seconds",
          "legendFormat": "latência",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "lag0_netbird_peer_handshake_age_seconds",
          "legendFormat": "handshake",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "layer": true,
              "fqdn": true,
              "lag0_netbird_peer_info": true
            },
            "renameByName": {
              "peer": "peer",
              "ip": "netbird IP",
              "status": "status",
              "connection_type": "caminho",
              "rx": "rx",
              "tx": "tx",
              "latência": "latência",
              "handshake": "handshake"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rx"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tx"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "latência"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "handshake"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Connected": {
                        "color": "green",
                        "index": 0
                      },
                      "Connecting": {
                        "color": "orange",
                        "index": 1
                      },
                      "Idle": {
                        "color": "text",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "caminho"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "P2P": {
                        "color": "green",
                        "index": 0
                      },
                      "Relayed": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
