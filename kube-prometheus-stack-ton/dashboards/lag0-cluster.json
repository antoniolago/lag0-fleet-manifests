            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (namespace, phase) (kube_pod_status_phase) > 0",
          "legendFormat": "{{namespace}} {{phase}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "transformations": [
