{
  "uid": "lag0-holanda",
  "title": "VPS ton-holanda · Tráfego, Cota & Quem Usou",
  "description": "ton-holanda (88.216.187.80): exit node do NetBird e borda de mail. Quanto o plano já consumiu, o que está passando agora e qual peer puxou cada byte. Fonte: node_exporter + vnstat + wg show na própria VPS.",
  "tags": [
    "lag0",
    "vps",
    "trafego",
    "netbird",
    "cota"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "quota_gb",
        "label": "Cota mensal (GB)",
        "type": "custom",
        "query": "50,100,250,500,1000,2000,5000",
        "current": {
          "selected": true,
          "text": "1000",
          "value": "1000"
        },
        "options": [],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "description": "Usada quando /etc/ton-traffic.conf na VPS não define TON_QUOTA_BYTES."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Cota do mês e tráfego WAN",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "% da cota do mês",
      "description": "Tráfego do mês corrente (rx+tx no eth0, base do vnstat) dividido pela cota. A cota vem de /etc/ton-traffic.conf (TON_QUOTA_BYTES); se estiver 0, usa a variável quota_gb.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * ((sum(ton_holanda_traffic_month_rx_bytes{job=\"ton-holanda\"}) + sum(ton_holanda_traffic_month_tx_bytes{job=\"ton-holanda\"})) / ((ton_holanda_quota_bytes{job=\"ton-holanda\"} > 0) or vector($quota_gb * 1073741824)))",
          "legendFormat": "% da cota do mês",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
