          "legendFormat": "peers → wt0 (upload deles)",
          "refId": "B",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(node_network_receive_bytes_total{job=\"ton-holanda\",device=\"eth0\"}[10m])) * 8",
          "legendFormat": "eth0 recebido",
